# PostgreSQL Settings
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=n8n_password_secret_123
POSTGRES_DB=whatsapp_ai_db

# n8n Login Credentials
N8N_USER=admin
N8N_PASSWORD=SuperSecurePassword123!

# Public Tunnel URL (Updated whenever Cloudflare tunnel is restarted)
WEBHOOK_URL=https://your-cloudflare-tunnel-subdomain.trycloudflare.com/

# Meta WhatsApp Cloud API Credentials
META_WHATSAPP_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345
META_VERIFY_TOKEN=my_secure_whatsapp_verify_token_2026

# Ollama Settings
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Odoo CRM Credentials
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db
ODOO_USERNAME=admin@example.com
ODOO_PASSWORD=admin_password
