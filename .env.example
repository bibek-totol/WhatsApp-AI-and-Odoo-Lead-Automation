# PostgreSQL Settings
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=n8n_password
POSTGRES_DB=telegram_ai_db

# n8n Login Credentials
N8N_USER=admin
N8N_PASSWORD=SmartSecure12!

# Public Tunnel URL (Updated whenever Cloudflare tunnel is restarted)
WEBHOOK_URL=https://your-cloudflare-tunnel-subdomain.trycloudflare.com/

# Telegram Bot API Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_SECRET_TOKEN=my_secure_telegram_secret_token_2026

# Ollama Settings
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
ENABLE_AI_ASSISTANT=true

# Odoo CRM Credentials
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db
ODOO_USERNAME=admin@example.com
ODOO_PASSWORD=admin_password
